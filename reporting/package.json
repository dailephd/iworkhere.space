{
  "name": "iworkhere-reporting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3002",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsx script/verify.ts",
    "test:permissions": "tsx script/permissionSmoke.cts --docker",
    "test:runtime": "tsx script/runtimeSmoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@neondatabase/serverless": "1.1.0",
    "@stytch/nextjs": "22.4.0",
    "jose": "6.2.17",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
