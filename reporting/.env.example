# Separate reporting deployment only. OAuth/database credentials are server-only.
# Only the explicitly public login SDK tokens below use NEXT_PUBLIC_*.
# Missing private configuration denies data access; public discovery is independent.
REPORTING_RESOURCE_URL=https://reporting.example.invalid/mcp
REPORTING_OAUTH_ISSUER=https://issuer.example.invalid
# standard (at+jwt), stytch-test (staging only), or stytch-live (pinned Production).
REPORTING_OAUTH_PROFILE=standard
REPORTING_OAUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
REPORTING_OAUTH_INTROSPECTION_URL=https://issuer.example.invalid/oauth/introspect
REPORTING_INTROSPECTION_CLIENT_ID=
REPORTING_INTROSPECTION_CLIENT_SECRET=
# Rotation acceptance only: keep primary intact, place next in a separate secret.
# next is allowed only with explicit Test fixture Preview, never production.
REPORTING_INTROSPECTION_CREDENTIAL_SLOT=current
REPORTING_INTROSPECTION_CLIENT_SECRET_NEXT=
# Omit normally. Literal true enables labelled synthetic aggregate reports only
# in Stytch Test Vercel Preview; any database credential makes this fail closed.
# REPORTING_PREVIEW_FIXTURE=true
# JSON array of immutable provider subject IDs, explicitly enrolled by the operator.
REPORTING_ALLOWED_SUBJECTS=[]
# Optional preactivation probe. Omit normally; presence always blocks reporting.
# Use epoch milliseconds <=15 minutes ahead to observe only signed enrolled
# operator compatibility facts. Expired/invalid values stay closed, never activate.
# REPORTING_LIVE_VALIDATION_UNTIL=1
# Optional explicit same-token revocation self-check inside that deny-only window.
# Remove both validation settings before enabling reporting. Never revokes normally.
# REPORTING_LIVE_VALIDATION_REVOKE=true
# Username must be observability_reporting; provision separately after grant review.
REPORTING_DATABASE_URL=
# Stytch Test login/consent UI only. Public SDK token, never the project secret.
# Does not authorize the MCP endpoint or enroll an operator.
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=
# Separate Live login/consent UI. Does not enable production MCP authorization.
NEXT_PUBLIC_STYTCH_LIVE_PUBLIC_TOKEN=
