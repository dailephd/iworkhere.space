  "operation": [
    {
      "id": "compress-pdf-processed",
      "exampleId": "compress-pdf-example",
      "toolId": "compress-pdf",
      "summary": "Compress the source PDF with the default tool behavior.",
      "step": [
        {
          "kind": "choose-files",
          "control": "Choose PDF",
          "asset": [
            "public/examples/v0.4.3/compress-pdf/source.pdf"
          ]
        },
        {
          "kind": "press-button",
          "control": "Compress PDF",
          "waitForHeading": "Smaller PDF ready"
        },
        {
          "kind": "download",
          "control": "Download compressed PDF",
          "filename": "source-compressed.pdf",
          "saveAs": "public/examples/v0.4.3/compress-pdf/processed.pdf"
        }
      ]
    },
    {
      "id": "pdf-to-image-png",
      "exampleId": "pdf-to-image-example",
      "toolId": "pdf-to-image",
      "summary": "Convert page 1 to a PNG at 150 DPI.",
      "step": [
        {
          "kind": "choose-files",
          "control": "Choose PDF",
          "asset": [
            "public/examples/v0.4.3/pdf-to-image/source.pdf"
          ]
        },
        {
          "kind": "set-text",
          "control": "Pages to convert",
          "value": "1"
        },
        {
          "kind": "choose-option",
          "control": "Output format",
          "value": "png"
        },
        {
          "kind": "choose-option",
          "control": "Resolution (DPI)",
          "value": "150"
        },
        {
          "kind": "press-button",
          "control": "Convert pages",
          "waitForHeading": "Page images ready"
        },
        {
          "kind": "download",
          "control": "Download page 1",
          "filename": "source-page-001.png",
          "saveAs": "public/examples/v0.4.3/pdf-to-image/page-001.png"
