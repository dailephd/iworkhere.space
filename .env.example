# Public browser telemetry; false keeps analytics and logging local.
NEXT_PUBLIC_OBSERVABILITY_ENABLED=false

# Server-only durable metrics are opt-in. Keep the DB URL empty unless configured.
OBSERVABILITY_PERSISTENCE_ENABLED=false
OBSERVABILITY_DATABASE_URL=

# Set only when configuring the public Vercel maintenance cron.
CRON_SECRET=

# AdSense is opt-in and requires external account/CMP readiness.
NEXT_PUBLIC_ADSENSE_ENABLED=false
