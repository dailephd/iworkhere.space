# Public browser telemetry; false keeps analytics and logging local.
NEXT_PUBLIC_OBSERVABILITY_ENABLED=false

# Public build-time flag, not a secret; false/unset keeps Vercel traffic analytics off.
# Set exact true only for public Production after enabling Web Analytics in Vercel.
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Server-only durable metrics are opt-in. Keep the DB URL empty unless configured.
OBSERVABILITY_PERSISTENCE_ENABLED=false
OBSERVABILITY_DATABASE_URL=

# Set only when configuring the public Vercel maintenance cron.
CRON_SECRET=

# AdSense is opt-in and requires external account/CMP readiness.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# User reports (v0.4.2). The public flag defaults off; enable only after the external provisioning in docs/DEPLOYMENT.md.
NEXT_PUBLIC_SUPPORT_ENABLED=false
NEXT_PUBLIC_SUPPORT_TURNSTILE_SITE_KEY=
# Server-only support credentials and providers. Leave empty unless configured; missing values fail closed.
SUPPORT_DATABASE_URL=
SUPPORT_WORKER_DATABASE_URL=
SUPPORT_TURNSTILE_SECRET=
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPOSITORY=
SUPPORT_RESEND_API_KEY=
SUPPORT_EMAIL_FROM=
SUPPORT_OPERATOR_EMAIL=
SUPPORT_DASHBOARD_BASE_URL=
# Retention purge stays off until the retention policy is approved.
SUPPORT_RETENTION_ENABLED=false
